# Dependencies (EAS installs these fresh)
node_modules
**/node_modules

# Git
.git/

# Local env (never send to build servers)
.env.local

# Google Play service account key (used locally by eas submit, never send to build servers)
credentials/

# Test & coverage
coverage/
__tests__/

# Android native project (CNG: EAS prebuilds from app.json. A local android/ dir from
# `yarn android` would switch EAS to bare mode and break the build — never upload it)
android/

# iOS native project (CNG: EAS prebuilds from app.json. A local ios/ dir from
# `yarn ios` would switch EAS to bare mode and build the stale Xcode project
# (app name "mobile", old icon, English permission strings) — never upload it.
# TestFlight builds 20/21/23/24 were affected; build 22 was built from a worktree without ios/)
ios/

# Build artifacts
dist/

# Xcode の派生データ（Xcode 27 でのローカルビルド時に xcodebuild が生成する
# CompilationCache / ModuleCache など）。3GB 超あり、含めると EAS へのアップロードが
# 146MB → 1.2GB になる（TestFlight build 31 / Play versionCode 16 で発生）
build/

# Docs
docs/

# Lambda / API (not needed for mobile builds)
api
.aws-sam

# Mock server scripts
scripts/server.ts

# Demo account seed assets
demo-assets/

# モック API サーバー（src/data/*.ts）とユニットテストだけが参照するサンプル音源。
# 合計 130MB あり、これを含めると EAS へのアップロードが 271MB になるため除外する（TASK-123）。
# ただし `src/assets/audio/silence.wav` は useHeadphonesConnected が require する
# アプリ本体の資産（TASK-115）なので除外しない。ディレクトリごと除外すると
# ネゲーション（!）で戻せず、EAS の Bundle JavaScript フェーズが
# 「Unable to resolve asset」で失敗する（TestFlight build 29 で発生）。
src/assets/audio/*
!src/assets/audio/silence.wav
src/assets/record/
