{
  "compilerOptions": {
    "outDir": ".lambda-build/dist",
    "rootDir": "api/lambda",
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": false,

    "types": ["node"],
    "lib": ["es2020"],

    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["api/lambda/**/*.ts"],
  "exclude": ["node_modules", "src", "App.tsx", "expo-env.d.ts"]
}
