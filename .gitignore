# dependencies
node_modules/

# Expo
.expo/
dist/
build/
web-build/
expo-env.d.ts

# Native
ios/
android/
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*
*.log

# macOS
.DS_Store
*.pem

# local env files
.env*.local
env.local

# AWS SAM build artifacts
api/.aws-sam/

# Google Play service account key (EAS submit) — never commit
credentials/

# typescript
*.tsbuildinfo

# Yarn
.yarn/install-state.gz

# Claude Code (settings files contain secrets, commands are shared)
.claude/*.json

# Test
coverage/

app-example

# デモアカウント用のシード素材（音源・画像）。リポジトリには含めない
demo-assets/

# E2E フローの takeScreenshot / startRecording の出力（手元確認用）
.maestro/screenshots/
