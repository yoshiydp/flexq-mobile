{
  "expo": {
    "name": "FlexQ",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yoshiydp.lyricsapp",
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.134608896734-hb1nj0rmlgva07vf6ejlmb1lb6mhr1pi"
            ]
          }
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "プロフィール画像やトラックのアートワークを設定するために写真へのアクセスを許可してください。",
        "NSSpeechRecognitionUsageDescription": "音声をテキストに変換するために音声認識の使用を許可してください。"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/adaptive-icon.png",
        "backgroundColor": "#6C3483"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.yoshiydp.lyricsapp",
      "scheme": "com.yoshiydp.lyricsapp",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BLUETOOTH_CONNECT"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./src/assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#6C3483"
        }
      ],
      "expo-font",
      "expo-asset",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "プロフィール画像やトラックのアートワークを設定するために写真へのアクセスを許可してください。"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "音声文字起こしのためにマイクへのアクセスを許可してください。",
          "speechRecognitionPermission": "音声をテキストに変換するために音声認識の使用を許可してください。"
        }
      ],
      "react-native-audio-api"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "216ca5f0-4ffc-4067-bfbf-5f56aba4924b"
      }
    },
    "runtimeVersion": "1.1.0",
    "updates": {
      "url": "https://u.expo.dev/216ca5f0-4ffc-4067-bfbf-5f56aba4924b"
    }
  }
}
